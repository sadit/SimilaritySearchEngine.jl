  "description": "A client of the HTTP API of similarity-search-serve, the server of SimilaritySearchEngine.jl.",
  "license": "MIT",
  "author": "Eric S. Tellez <donsadit@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadit/SimilaritySearchEngine.jl.git",
